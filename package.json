{
  "name": "untypo",
  "version": "0.2.3",
  "private": true,
  "description": "Open-source AI dictation client",
  "author": "Nexaorion Inc.",
  "license": "Apache-2.0",
  "main": "dist/main/index.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "node scripts/dev.mjs",
    "build:main": "tsc --project tsconfig.main.json",
    "build:native": "node scripts/build-native.mjs",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:main && npm run build:renderer && npm run build:native",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke-test",
    "smoke:native": "npm run build && node scripts/native-smoke.mjs",
    "typecheck": "tsc --project tsconfig.main.json --noEmit && tsc --project tsconfig.renderer.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "package:dir": "npm run build && electron-builder --dir --win",
    "package:dir:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --mac --arm64",
    "package:win": "npm run build && electron-builder --win nsis",
    "package:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip --arm64"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1159.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@lobehub/icons-static-svg": "1.101.0",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@sentry/electron": "^8.3.0",
    "better-sqlite3": "13.0.3",
    "electron-updater": "^6.8.11",
    "webdav": "5.11.0"
  }
}
