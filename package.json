{
  "name": "untypo",
  "version": "0.1.4",
  "private": true,
  "description": "Open-source AI dictation client for Windows",
  "author": "UnTypo contributors",
  "main": "dist/main/index.js",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "dev": "node scripts/dev.mjs",
    "build:main": "tsc --project tsconfig.main.json",
    "build:native": "node scripts/build-native.mjs",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:main && npm run build:renderer && npm run build:native",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke-test",
    "smoke:native": "npm run build && node scripts/native-smoke.mjs",
    "typecheck": "tsc --project tsconfig.main.json --noEmit && tsc --project tsconfig.renderer.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "package:dir": "npm run build && electron-builder --dir --win",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "eslint": "10.9.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@lobehub/icons-static-svg": "1.94.0",
    "@mui/icons-material": "9.3.1",
    "@mui/material": "9.3.1",
    "better-sqlite3": "13.0.3",
    "electron-updater": "^6.8.9"
  }
}
