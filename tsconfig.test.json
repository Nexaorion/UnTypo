{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "target": "ES2023",
    "types": ["node", "vitest/globals"]
  },
  "include": ["tests/**/*.ts", "src/main/**/*.ts", "src/shared/**/*.ts"]
}
